# ==============================================================================
# OAuth2-Proxy Enterprise Configuration (SSO & Identity Gateway)
# ==============================================================================

# HTTP binding
http_address = "0.0.0.0:4180"
reverse_proxy = true

# Upstream proxy target (JIT Provisioner)
upstreams = [
    "http://jit-provisioner:3001/"
]

# Identity Provider (OIDC / rIDM / Keycloak / Entra ID)
provider = "oidc"
oidc_issuer_url = "${OIDC_ISSUER_URL}"
client_id = "${OIDC_CLIENT_ID}"
client_secret = "${OIDC_CLIENT_SECRET}"
scope = "openid profile email"

# Claim mapping: use 'nip' for BPS rIDM or 'preferred_username' / 'sub'
user_id_claim = "${OIDC_USER_CLAIM}"
email_domains = [ "*" ]

# Cookie configuration
cookie_name = "_llumen_sso"
cookie_secret = "${COOKIE_SECRET}"
cookie_secure = true
cookie_httponly = true
cookie_samesite = "lax"
cookie_expire = "168h"
cookie_refresh = "1h"

# Upstream header forwarding (EIP Channel Adapter)
set_xauthrequest = true
pass_user_headers = true
pass_basic_auth = false
pass_access_token = false

# Valkey / Redis Session Storage (Distributed Session Persistence)
session_store_type = "redis"
redis_connection_url = "redis://:${VALKEY_PASSWORD}@valkey:6379"

# Logging
request_logging = true
silence_ping_logging = true
auth_logging = true
