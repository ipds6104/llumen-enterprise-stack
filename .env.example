# ==============================================================================
# LLUMEN ENTERPRISE STACK - ENVIRONMENT CONFIGURATION (CISO READY)
# ==============================================================================

# --- Domain & Deployment Environment ---
DOMAIN=llumen.dvlpid.my.id
STACK_ENV=production
TZ=Asia/Jakarta

# --- Enterprise Identity Provider (SSO / OIDC) ---
# Default points to rIDM Tenant (BPS Mempawah SSO)
OIDC_ISSUER_URL=https://auth.dvlpid.my.id/t/bps
OIDC_CLIENT_ID=llumen-enterprise-app
OIDC_CLIENT_SECRET=replace-with-client-secret-from-idp
OIDC_SCOPE=openid profile email
# Claim used as Llumen username (e.g., 'nip', 'preferred_username', or 'email')
OIDC_USER_CLAIM=nip
# 32-byte base64 string for cookie encryption (generate via: openssl rand -base64 32)
COOKIE_SECRET=replace-with-openssl-rand-base64-32
LOGOUT_REDIRECT_URL=https://auth.dvlpid.my.id/t/bps/sessions/logout

# --- SAML 2.0 Federation (Optional - activated with docker-compose.saml.yml) ---
SAML_IDP_METADATA_URL=https://auth.dvlpid.my.id/t/bps/saml/metadata
SAML_SP_ENTITY_ID=https://llumen.dvlpid.my.id/saml/metadata

# --- Core Llumen Engine (pinkfuwa/llumen) ---
OPENROUTER_API_KEY=sk-or-v1-your-openrouter-key-here
LLM_API_BASE=https://openrouter.ai/api
LLUMEN_IMAGE=ghcr.io/pinkfuwa/llumen:latest
LLUMEN_TRUSTED_HEADER=X-Forwarded-User

# --- EIP JIT Provisioner & Identity Mediator ---
JIT_PORT=3001
JIT_SQLITE_PATH=/data/db.sqlite
JIT_AUTH_GATEWAY_URL=http://auth-gateway:4180
JIT_LOG_LEVEL=info
# Auto-provision new users into SQLite upon successful SSO
JIT_AUTO_PROVISION=true

# --- CISO Guardrails & RBAC Controls ---
# Comma-separated list of authorized groups/satkers (e.g., '6104,bps-pegawai'). Leave empty for open access.
ALLOWED_GROUPS=6104
# Comma-separated list of allowed tenants. Leave empty for all tenants.
ALLOWED_TENANTS=bps
# Emergency killswitch: immediately halts all chat traffic when set to 'true'
KILLSWITCH_ENABLED=false

# --- Enterprise AI Gateway & DLP Overlay (docker-compose.gateway.yml) ---
AI_GATEWAY_MASTER_KEY=sk-enterprise-litellm-master-key

# --- Distributed Session & Cache (Valkey / Redis) ---
VALKEY_PORT=6379
VALKEY_PASSWORD=replace-with-strong-valkey-password

# --- Edge Ingress & TLS (Traefik) ---
TRAEFIK_ACME_EMAIL=admin@dvlpid.my.id
TRAEFIK_HTTP_PORT=80
TRAEFIK_HTTPS_PORT=443
TRAEFIK_DASHBOARD_ENABLED=false
# Set to 'true' if behind Cloudflare Tunnel or external SSL termination proxy
BEHIND_REVERSE_PROXY=false
